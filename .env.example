# Server settings (server/index.ts). Copy to .env on the server and fill in. Never commit the real .env.

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Who receives the applications: chat IDs, comma-separated. Each person must open the bot and press Start first.
TELEGRAM_CHAT_IDS=
PORT=3000
HOST=127.0.0.1
# 1 when the server sits behind nginx
TRUST_PROXY=1

# Site build (optional): where the form posts. Leave empty to use this server's /api/lead.
VITE_LEAD_ENDPOINT=

# Bot for users (server/bot): leads, required channel, referrals, closed courses.
# The bot must be an ADMIN of both channels (to check subscriptions and to let people into the closed one).
REQUIRED_CHANNEL=@inspiringuz
# Private channel with the closed courses, numeric ID like -1001234567890 (forward a post from it to @userinfobot).
CLOSED_CHANNEL_ID=
# How many invited friends open the closed courses
REFERRAL_GOAL=5
# Daily Excel report to the admins (TELEGRAM_CHAT_IDS) at this hour, Tashkent time; "off" to disable
REPORT_HOUR=20
# Where the bot keeps its data (SQLite). Back it up by copying the file.
BOT_DB=data/bot.db
