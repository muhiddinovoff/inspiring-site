{
  "name": "inspiring-site",
  "version": "1.0.0",
  "private": true,
  "description": "Inspiring Education — Prezident va ixtisoslashtirilgan maktablarga tayyorlov markazining sayti",
  "homepage": "https://muhiddinovoff.github.io/inspiring-site/",
  "repository": {
    "type": "git",
    "url": "https://github.com/muhiddinovoff/inspiring-site.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/localize-html.ts",
    "preview": "vite preview",
    "server": "node server/index.ts",
    "bot:setup": "node server/bot-setup.ts",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run test && npm run build",
    "cutout": "python3 scripts/cutout.py && prettier --write src/data/hero-cutouts.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.7.1",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.27",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
